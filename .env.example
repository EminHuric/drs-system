# ─────────────────────────────────────────────────────────────
#  RDS — Firebase konfiguracija
#  Kopiraj ovaj fajl u  .env  i popuni vrednostima iz
#  Firebase Console → Project settings → Your apps → Web app.
#
#  Ove vrednosti NISU tajne — Firebase web ključevi su javni po
#  dizajnu. Pristup podacima čuvaju Firestore Security Rules
#  (fajl firestore.rules), ne ovaj ključ.
# ─────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email adrese vlasnika platforme (glavni admin).
# Odvoji zarezom ako ih ima više.
# ⚠️ MORA da bude identično listi u firestore.rules → superAdmins()
VITE_SUPER_ADMIN_EMAILS=emynbusiness@gmail.com
